# 不纳入版本控制
# （tests/ 曾在此列表——但 133 个测试文件早已全部被追踪，规则名存实亡，
#   每次新增测试都要 git add -f 绕行；已移除。测试是资产必须进版本控制。）
docs/

# Python 构建产物
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# pytest / ruff 缓存
.pytest_cache/
.ruff_cache/

# IDE 配置
.idea/

# codegraph 运行时
.codegraph/daemon.log
.codegraph/daemon.pid

# superpowers 插件数据
.superpowers/

# 会话级 worktree（CCAR12 Task 6：worktree_enter 建在 repo_root/.worktrees/）
.worktrees/

# 桌面 GUI 分支(master)残留:cli-dev 不用 frontend/backend,
# 切分支时 node_modules / __pycache__(gitignored)会残留在磁盘,
# 这里屏蔽让 git status 干净。磁盘保留 node_modules 省得切回 master 重装。
frontend/
backend/
/.playwright-mcp/
/.impeccable/
/.codegraph/
/.omnimate/
/dist/

# Python 构建产物（python -m build 生成的 sdist/wheel）
/build/

# 临时调试脚本（不进 git，需要时手动保留）
/dump_llm_payload.py
/dump_llm_payload_full.py
/verify_ctxopt_live.py
/snapshot_report.html
/.superpowers/

# 一级目录本地化：点开头的、tests/、CLAUDE.md 只留本地，不进仓库
# 例外：.gitignore 本身要进仓库（忽略规则不进仓库 = clone 后全裸奔）
/.*
!/.gitignore
/tests/
/CLAUDE.md
